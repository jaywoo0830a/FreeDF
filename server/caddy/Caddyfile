# FreeDF — 1Gbps 서버용 Caddy 설정 (HTTP/3 + HTTP/2 + HTTP/1.1, 자동 HTTPS)
#
# 설치 (Ubuntu VPS — 호스트에서 실행하는 웹 서버):
#   sudo apt-get update && sudo apt-get install -y caddy
#   sudo cp server/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# 요구 사항:
#   * 호스트 커널은 이미 QUIC/네트워크 튜닝됨 (여기서는 건드리지 않음).
#   * 방화벽: TCP 80/443 + **UDP 443** (HTTP/3은 QUIC/UDP 443 사용).
#       sudo ufw allow 80,443/tcp
#       sudo ufw allow 443/udp
#   * 프록시 대상: nginx 가 0.0.0.0:8081 에서 평문으로 기동 중 (server/).
#   * 도메인을 바꾸면 server/nginx/freedf.conf 의 server_name 과
#     server/backend/.env 의 PUBLIC_BASE_URL 도 함께 수정하세요.
{
    admin off                  # 공유 VPS — 원격 관리 감사 로그 비활성 (감사 기능 off)
    https_port 443
}

# 자동 HTTPS(TLS 1.3) + HTTP/3(QUIC): Caddy 2.8+ 는 TLS가 켜진 이 사이트에서
# **HTTP/3(QUIC/443-UDP)** 를 자동으로 함께 서빙합니다 (별도 지시어 불필요).
# 브라우저가 HTTP/3을 지원하면 443/UDP, 아니면 HTTP/2·HTTP/1.1 로 443/TCP를
# 수용합니다. UDP 443 이 방화벽에서 열려 있어야 합니다 (README 참고).
freedf.rlawjddn00.online {

    # 1Gbps 대용량 업로드: Caddy 는 요청 본문 크기 제한이 없으므로
    # multipart 미디어(~200MB)·Sync 스냅샷을 그대로 통과시킵니다
    # (nginx 200m 상한과 nginx/backend 가 실제 대역폭을 관리).

    # nginx(8081, 평문)로 프록시. Caddy 는 Host/X-Forwarded-For/
    # X-Forwarded-Proto(http/https) 를 자동 보강해 뒤의 nginx·backend 가
    # 원본 IP와 프로토콜(HTTP/3 포함)을 압니다.
    reverse_proxy localhost:8081 {
        # backend(nginx) 와의 커넥션 풀 튜닝 — Caddy 기본값 대부분 최적.
    }

    # HSTS — 최초 HTTPS 접속 후 평문으로 돌아가지 않도록 1년.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}